---
import Base from '../layouts/Base.astro';
import { getWork } from '../lib/content';
import { site } from '../lib/site';

const projects = await getWork();
---

<Base caseLine={`portfolio · ${site.location}`}>
  <section>
    <h1 class="text-5xl font-light tracking-tight sm:text-7xl">
      {site.fullName.split(' ')[0]} <span class="text-signal">{site.fullName.split(' ').slice(1).join(' ')}</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted">{site.role}</p>
  </section>

  <section class="mt-20 border-t border-border pt-6">
    <h2 class="font-mono text-xs uppercase tracking-widest text-muted">work</h2>
    <ul class="mt-6 flex flex-col gap-px bg-border">
      {projects.map(({ id, data }) => (
        <li class="bg-background">
          <a href={`/work/${id}/`} class="group block bg-card p-6 transition-colors hover:bg-background">
            <div class="flex items-baseline justify-between gap-4 font-mono text-xs uppercase tracking-widest text-muted">
              <span>{data.domain}</span>
              <span class:list={[{ 'text-signal': data.status === 'offline', 'text-live': data.status === 'live' }]}>{data.status} · {data.started}</span>
            </div>
            <h3 class="mt-4 text-3xl font-light tracking-tight">{data.title}</h3>
            <p class="mt-2 max-w-xl text-sm text-muted">{data.summary}</p>
            <div class="mt-6 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-faint">
              {data.stack.map((s) => <span>{s}</span>)}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
