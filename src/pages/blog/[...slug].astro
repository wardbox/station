---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getAllPosts, postSlug, formatDate, type Post } from '../../lib/content';
import { postReadTime } from '../../lib/readtime';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
interface Props { post: Post }
const { post } = Astro.props as Props;
const { data } = post.entry;
const { Content } = await render(post.entry);
const tags = [...(data.filed ?? []), ...(data.stack ?? [])];
---

<Base title={data.title} description={data.summary} caseLine={`${post.type} · ${formatDate(data.date)} · ${postReadTime(post)}`}>
  <article>
    <a href="/blog/" class="font-mono text-xs uppercase tracking-widest text-muted hover:text-foreground">← blog</a>
    <h1 class="mt-6 text-5xl font-light tracking-tight sm:text-7xl">{data.title}</h1>
    <p class="mt-6 max-w-xl text-lg text-muted">{data.summary}</p>
    <div class="prose mt-20">
      <Content />
    </div>
    {tags.length > 0 && (
      <div class="mt-20 border-t border-border pt-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-muted">filed under</h2>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-faint">
          {tags.map((t) => <span>{t}</span>)}
        </div>
      </div>
    )}
  </article>
</Base>
