---
import '../styles/global.css';
import { site } from '../lib/site';
import { rev, builtDate } from '../lib/build';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  caseLine: string;
}
const { title, description = site.tagline, image, caseLine } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;
const path = Astro.url.pathname;
const nav = [
  { label: 'work', href: '/', current: path === '/' || path.startsWith('/work/') },
  { label: 'blog', href: '/blog/', current: path.startsWith('/blog/') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen">
    <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-6 py-8 sm:px-8">
      <header>
        <div class="flex items-baseline justify-between gap-6">
          <a href="/" class="text-base font-light tracking-tight">{site.name}</a>
          <nav class="flex gap-5 font-mono text-xs uppercase tracking-widest text-muted" aria-label="Site">
            {nav.map((n) => (
              <a href={n.href} class:list={['hover:text-foreground', { 'text-foreground': n.current }]} aria-current={n.current ? 'page' : undefined}>{n.label}</a>
            ))}
            {site.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="hover:text-foreground">{l.label}</a>
            ))}
          </nav>
        </div>
        <div class="mt-3 flex justify-between gap-4 border-t border-border pt-3 font-mono text-xs uppercase tracking-widest text-muted">
          <span>{caseLine}</span>
          <span>{builtDate}</span>
        </div>
      </header>
      <main class="flex-1 pt-20 pb-24">
        <slot />
      </main>
      <footer class="flex justify-between border-t border-border pt-3 font-mono text-xs uppercase tracking-widest text-faint">
        <span>{site.location}</span>
        <span>rev {rev}</span>
      </footer>
    </div>
    <dialog id="lightbox" class="lightbox" aria-label="Image viewer">
      <img alt="" />
    </dialog>
    <script>
      const box = document.getElementById('lightbox') as HTMLDialogElement;
      const big = box.querySelector('img')!;
      const open = (img: HTMLImageElement) => {
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        box.showModal();
      };
      box.addEventListener('click', () => box.close());
      for (const img of document.querySelectorAll<HTMLImageElement>('article img')) {
        if (img.closest('a')) continue;
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        img.classList.add('zoomable');
        img.addEventListener('click', () => open(img));
        img.addEventListener('keydown', (e) => (e.key === 'Enter' || e.key === ' ') && (e.preventDefault(), open(img)));
      }
    </script>
  </body>
</html>
